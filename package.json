{
  "name": "htsg-interactive-lab",
  "version": "1.0.1",
  "private": true,
  "description": "Three HTSG browser games for public demonstrations. Static files only.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs --dir public",
    "preview": "node scripts/serve.mjs --dir dist",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser-qa.mjs",
    "build": "node scripts/build.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "package:wordpress": "node scripts/package-wordpress.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}

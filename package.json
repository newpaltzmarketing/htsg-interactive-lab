{
  "name": "htsg-interactive-lab",
  "version": "1.5.1",
  "private": true,
  "description": "Three free HTSG browser games with optional first-party community challenges.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs --dir public",
    "preview": "node scripts/serve.mjs --dir dist",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser-qa.mjs",
    "test:polish": "node tests/agency-polish-qa.mjs",
    "test:controls": "node tests/control-panel-qa.mjs",
    "test:upgrade": "node tests/upgrade-qa.mjs",
    "test:gamification": "node tests/gamification-qa.mjs",
    "test:share": "node tests/share-preview-qa.mjs",
    "test:community": "node tests/community-qa.mjs",
    "artwork:share": "node scripts/generate-share-card.mjs",
    "metadata:sync": "node scripts/sync-share-metadata.mjs",
    "build": "node scripts/build.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "package:wordpress": "node scripts/package-wordpress.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
